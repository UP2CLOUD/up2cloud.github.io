# www → apex: handled by functions/_middleware.js, NOT here — Cloudflare
# Pages' `_redirects` file does not support hostname-based matching (only
# path matching), so a rule like
#   https://www.up2cloud.tech/* https://up2cloud.tech/:splat 301
# is silently ignored. See functions/_middleware.js for the real redirect.

# Block sensitive files
/package.json /404.html 404
/package-lock.json /404.html 404
/build.sh /404.html 404
/serve.js /404.html 404
/serve.py /404.html 404
/tailwind.config.js /404.html 404
/.env* /404.html 404
/src/* /404.html 404
/scripts/* /404.html 404
/node_modules/* /404.html 404

# Retired duplicate: privacy/index_old.html was a stale copy of /privacy/ that
# canonicalised to it. Now deleted — 301 rather than letting it fall through
# to the 404 catch-all, so any lingering index entries or inbound links land
# on the real page instead of dead-ending. Both forms, because Cloudflare
# rewrites the .html URL to the extensionless one before matching.
/privacy/index_old.html /privacy/ 301
/privacy/index_old      /privacy/ 301

# Canonical URL for the Vercel-hosted AI assistant shell.
/ai-assistent-model /ai-assistent-model/ 301

# 404 fallback
/* /404.html 404
